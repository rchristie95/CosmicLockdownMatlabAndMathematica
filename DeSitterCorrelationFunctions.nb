Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Quantum", " ", 
      RowBox[{"Algebra", ":", 
       RowBox[{"[", 
        RowBox[{"b", ",", "bDag"}], "]"}]}]}], "=", "1"}], ",", 
    RowBox[{"all", " ", "else", " ", "scalar"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"Unprotect", "[", "NonCommutativeMultiply", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "NonCommutativeMultiply", ",", "isScalar", ",", "b", ",", "bDag"}], 
     "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"NonCommutativeMultiply", "[", "]"}], ":=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"NonCommutativeMultiply", "[", "a_", "]"}], ":=", "a"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Anything", " ", "except", " ", "b", " ", "or", " ", "bDag", " ", "is", 
     " ", "scalar"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SetAttributes", "[", 
     RowBox[{"isScalar", ",", "Constant"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"isScalar", "[", "expr_", "]"}], ":=", 
     RowBox[{"FreeQ", "[", 
      RowBox[{"expr", ",", 
       RowBox[{"b", "|", "bDag"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Pull", " ", "scalars", " ", "out", " ", "of", " ", 
     "NonCommutativeMultiply"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"NonCommutativeMultiply", "[", 
      RowBox[{"first___", ",", 
       RowBox[{
        RowBox[{"s_", "?", "isScalar"}], "*", "rest_"}], ",", "tail___"}], 
      "]"}], ":=", 
     RowBox[{"s", "*", 
      RowBox[{"NonCommutativeMultiply", "[", 
       RowBox[{"first", ",", "rest", ",", "tail"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"NonCommutativeMultiply", "[", 
      RowBox[{"first___", ",", 
       RowBox[{"s_", "?", "isScalar"}], ",", "tail___"}], "]"}], ":=", 
     RowBox[{"s", "*", 
      RowBox[{"NonCommutativeMultiply", "[", 
       RowBox[{"first", ",", "tail"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Pretty", " ", 
     RowBox[{"display", ":", 
      RowBox[{
      "combine", " ", "repeated", " ", "operators", " ", "into", " ", 
       "powers"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"MakeBoxes", "[", 
      RowBox[{
       RowBox[{"NonCommutativeMultiply", "[", 
        RowBox[{"first___", ",", 
         RowBox[{"args", ":", 
          RowBox[{"Longest", "@", 
           RowBox[{"Repeated", "[", 
            RowBox[{"z_", ",", 
             RowBox[{"{", 
              RowBox[{"2", ",", "\[Infinity]"}], "}"}]}], "]"}]}]}], ",", 
         "rest___"}], "]"}], ",", "form_"}], "]"}], ":=", 
     RowBox[{"RowBox", "@", 
      RowBox[{"Flatten", "@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "@", 
             RowBox[{"{", "first", "}"}]}], ">", "0"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"MakeBoxes", "[", 
              RowBox[{
               RowBox[{"NonCommutativeMultiply", "[", "first", "]"}], ",", 
               "form"}], "]"}], ",", "\"\<**\>\""}], "}"}], ",", "Nothing"}], 
          "]"}], ",", 
         RowBox[{"SuperscriptBox", "[", 
          RowBox[{
           RowBox[{"MakeBoxes", "[", 
            RowBox[{"z", ",", "form"}], "]"}], ",", 
           RowBox[{"ToBoxes", "[", 
            RowBox[{
             RowBox[{"Length", "@", 
              RowBox[{"{", "args", "}"}]}], ",", "form"}], "]"}]}], "]"}], 
         ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "@", 
             RowBox[{"{", "rest", "}"}]}], ">", "0"}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<**\>\"", ",", 
             RowBox[{"MakeBoxes", "[", 
              RowBox[{
               RowBox[{"NonCommutativeMultiply", "[", "rest", "]"}], ",", 
               "form"}], "]"}]}], "}"}], ",", "Nothing"}], "]"}]}], 
        "}"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"MakeBoxes", "[", 
      RowBox[{
       RowBox[{"NonCommutativeMultiply", "[", "arg_", "]"}], ",", "form_"}], 
      "]"}], ":=", 
     RowBox[{"MakeBoxes", "[", 
      RowBox[{"arg", ",", "form"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SetAttributes", "[", 
     RowBox[{"NonCommutativeMultiply", ",", "Flat"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Canonical", " ", "commutation", " ", "relation", " ", "for", " ", 
     "ladder", " ", "operators"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"b", "**", "bDag"}], ":=", 
     RowBox[{"1", "+", 
      RowBox[{"bDag", "**", "b"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", "Linearity", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"u_", "**", 
      RowBox[{"(", 
       RowBox[{"v_", "+", "w_"}], ")"}]}], ":=", 
     RowBox[{
      RowBox[{"u", "**", "v"}], "+", 
      RowBox[{"u", "**", "w"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"v_", "+", "w_"}], ")"}], "**", "u_"}], ":=", 
     RowBox[{
      RowBox[{"v", "**", "u"}], "+", 
      RowBox[{"w", "**", "u"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Allow", " ", "power", " ", "shorthand"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"b", "/:", 
     RowBox[{"b", "^", "n_Integer"}], ":=", 
     RowBox[{"NonCommutativeMultiply", "@@", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"b", ",", "n"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bDag", "/:", 
     RowBox[{"bDag", "^", "n_Integer"}], ":=", 
     RowBox[{"NonCommutativeMultiply", "@@", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"bDag", ",", "n"}], "]"}]}]}], ";"}], "\n"}]}]], "Input",
